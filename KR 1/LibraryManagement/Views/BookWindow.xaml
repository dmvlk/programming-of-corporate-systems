<Window x:Class="LibraryManagement.Views.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление книги" 
        Height="700" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Название -->
        <Label Grid.Row="0" Grid.Column="0" Content="Название:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleTextBox" Margin="5" Padding="3" Height="30"/>

        <!-- ISBN -->
        <Label Grid.Row="1" Grid.Column="0" Content="ISBN:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ISBNTextBox" Margin="5" Padding="3" Height="30"/>

        <!-- Год -->
        <Label Grid.Row="2" Grid.Column="0" Content="Год:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="YearTextBox" Margin="5" Padding="3" Height="30" Text="2024" Width="100" HorizontalAlignment="Left"/>

        <!-- Издатель -->
        <Label Grid.Row="3" Grid.Column="0" Content="Издатель:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PublisherTextBox" Margin="5" Padding="3" Height="30"/>

        <!-- Количество -->
        <Label Grid.Row="4" Grid.Column="0" Content="В наличии:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="QuantityTextBox" Margin="5" Padding="3" Height="30" Text="1" Width="100" HorizontalAlignment="Left"/>

        <!-- Разделитель -->
        <Rectangle Grid.Row="5" Grid.ColumnSpan="2" Height="1" Fill="LightGray" Margin="0,10,0,10"/>

        <!-- Заголовок Авторы -->
        <Label Grid.Row="6" Grid.Column="0" Content="Авторы:" FontWeight="Bold" Margin="5"/>

        <!-- Выбор автора и кнопки -->
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="AuthorComboBox" 
                      Width="180" Height="30"
                      DisplayMemberPath="FullName"
                      Margin="0,0,5,0"/>
            <Button x:Name="AddAuthorButton" Content="+" Width="30" Height="30" Margin="2" 
                    Click="AddAuthorButton_Click" FontSize="16" FontWeight="Bold" Background="LightGreen"/>
            <Button x:Name="RemoveAuthorButton" Content="X" Width="30" Height="30" Margin="2" 
                    Click="RemoveAuthorButton_Click" FontSize="14" FontWeight="Bold" Background="LightPink"/>
            <Button x:Name="CreateAuthorButton" Content="+ Новый" Width="70" Height="30" Margin="2" 
                    Click="CreateAuthorButton_Click" Background="LightBlue"/>
        </StackPanel>

        <!-- Список выбранных авторов -->
        <ListBox Grid.Row="7" Grid.Column="1" x:Name="SelectedAuthorsListBox" 
                 Height="80" Margin="5" DisplayMemberPath="FullName"/>

        <!-- Заголовок Жанры -->
        <Label Grid.Row="8" Grid.Column="0" Content="Жанры:" FontWeight="Bold" Margin="5"/>

        <!-- Выбор жанра и кнопки -->
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="5">
            <ComboBox x:Name="GenreComboBox" 
                      Width="180" Height="30"
                      DisplayMemberPath="Name"
                      Margin="0,0,5,0"/>
            <Button x:Name="AddGenreButton" Content="+" Width="30" Height="30" Margin="2" 
                    Click="AddGenreButton_Click" FontSize="16" FontWeight="Bold" Background="LightGreen"/>
            <Button x:Name="RemoveGenreButton" Content="X" Width="30" Height="30" Margin="2" 
                    Click="RemoveGenreButton_Click" FontSize="14" FontWeight="Bold" Background="LightPink"/>
            <Button x:Name="CreateGenreButton" Content="+ Новый" Width="70" Height="30" Margin="2" 
                    Click="CreateGenreButton_Click" Background="LightBlue"/>
        </StackPanel>

        <!-- Список выбранных жанров -->
        <ListBox Grid.Row="9" Grid.Column="1" x:Name="SelectedGenresListBox" 
                 Height="80" Margin="5" DisplayMemberPath="Name"/>

        <!-- Кнопки Сохранить/Отмена -->
        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="100" Height="35" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="35" Margin="0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>